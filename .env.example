# PostgreSQL connection string used by the API and maritime query tools.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/vegastar

# Gemini API credentials and model identifiers.
GEMINI_API_KEY=
GEMINI_MODEL=

# Conversation summary and recent context controls.
CHAT_CONTEXT_TURNS=8
AGENT_MAX_TOOL_ROUNDS=6

# Docker Compose PostgreSQL settings.
POSTGRES_DB=vegastar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
